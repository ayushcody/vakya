# Backend env vars (also loaded from ../frontend/.env.local if present).
# Supabase is OPTIONAL. Leave these empty to run in local mode (everything is stored in backend/data).
# Fill all three for hosted mode with sign-in (see backend/supabase/README.md).
# string, URL. e.g. https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# string. SECRET.
SUPABASE_SERVICE_ROLE_KEY=
# string. SECRET. Needed to verify sign-in tokens in hosted mode.
SUPABASE_JWT_SECRET=
# integer. OPTIONAL. Seconds a signed audio link from Supabase storage stays valid (hosted mode). Default 3600.
# SIGNED_URL_EXPIRES_S=3600

# ---- Embeddings (Google): the language model and knowledge search ----
# string. SECRET. A Embeddings API key. Embeddings Flash writes the replies and chooses the tools; Embeddings embeddings search the
# business's documents, with plain keyword (BM25) search as the backup when embeddings are unavailable. Without it the agent
# answers every message with a fixed line in the caller's language and the desk shows "Needs a Embeddings key"; documents are
# searched by keyword only. Everything else still works.
EMBEDDINGS_API_KEY=
# string. OPTIONAL. SECRET. More Embeddings keys (from other Google accounts), separated by commas, spaces or new lines. Vakya uses
# EMBEDDINGS_API_KEY first, then these; when a key hits its quota or is invalid it moves to the next one at once.
# EMBEDDINGS_API_KEYS=
# The language model is reached through Google's OpenAI-compatible endpoint (services/embeddings.py has the doc links). To use
# another OpenAI-compatible endpoint, set these three (LLM_API_KEY wins over EMBEDDINGS_API_KEY for the language model).
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=embeddings-3.6-flash
# LLM_API_KEY=
# off | low | medium | high. OPTIONAL. Embeddings's reasoning effort for a reply (default low on Google's endpoint, off elsewhere).
# LLM_REASONING_EFFORT=low
# float 0..1. OPTIONAL (default 0.2). Temperature of a spoken answer; tool calls keep their own.
# LLM_ANSWER_TEMPERATURE=0.2
# integer. OPTIONAL (default 2). Retries on a 429 or a 5xx, honouring Retry-After (a wait over LLM_RETRY_MAX_WAIT_S, default 3, is not taken).
# LLM_RETRIES=2
# seconds. OPTIONAL (default 5). On a phone turn, the longest wait for the model's next bytes.
# PHONE_LLM_STALL_S=5
# Embeddings: embeddings-embedding-2 by default, 768 dimensions (128 to 3072). Changing either re-embeds saved documents on the
# next search. Hosted mode needs backend/supabase/migrations/023_embeddings_model_neutral.sql (vector(768)).
# EMBEDDINGS_EMBED_MODEL=embeddings-embedding-2
# EMBEDDINGS_EMBED_DIM=768
# BM25 keyword search fused with the embedding search (default on).
# HYBRID_SEARCH=on
# integer. OPTIONAL (default 100, at most 100). Texts per embedding request.
# EMBED_BATCH_SIZE=100
# on | off. OPTIONAL (default off). Keep embeddings of texts already seen in backend/data/embed_cache.sqlite.
# EMBED_DISK_CACHE=off

# ---- Gnani AI speech models (see docs/GNANI.md) ----
# string. REQUIRED for speech. Gnani AI (Vachana) API key, sent as the X-API-Key-ID header. SECRET. It turns on Prisma
# (hearing), Timbre (speaking) and voice cloning.
GNANI_API_KEY=
# string, URL. OPTIONAL (default https://api.vachana.ai).
GNANI_BASE_URL=https://api.vachana.ai
# prisma-v3.0|prisma-v2.5. OPTIONAL (default prisma-v3.0; only v3.0 takes several language codes as a hint).
GNANI_STT_MODEL=prisma-v3.0
# verbatim|transcribe|codemix|transliterate. OPTIONAL (default codemix: English in Latin script, numbers in words).
GNANI_STT_FORMAT=codemix
# string. OPTIONAL (default timbre-v2.5). Voice cloning always uses vachana-vc-v1.
GNANI_TTS_MODEL=timbre-v2.5
# string. OPTIONAL. Timbre voices as Name:language pairs; the first match for a language speaks it.
# Default: Nalini:hi,Kaveri:en,Poorvi:hi-en
GNANI_VOICES=Nalini:hi,Kaveri:en,Poorvi:hi-en
# string. OPTIONAL. Comma-separated words always sent to Prisma as keyterms (up to 200, with the agent's own names
# and terms): product names, clinic or university names, doctors.
GNANI_KEYTERMS=
# seconds. OPTIONAL (default 20, minimum 1). How long one Gnani HTTP request may take.
# GNANI_TIMEOUT_S=20

# -- The Gnani gateway, usage ledger and budget (docs/GNANI.md). Every Gnani request goes through one door: one active
# request at a time (a Gnani account answers 429 to a second one), live calls first, then desk work, then benchmarks.
# There is no second provider. When Gnani is busy or down a live call retries inside GNANI_LIVE_DEADLINE_S, then plays a
# pre-rendered Timbre line ("one moment please" / "I will call you back") and offers a callback or a person; other work
# is queued and retried.
# file path. OPTIONAL (default backend/data/usage.jsonl). Append-only record of every Gnani request: kind, seconds or
# characters, ESTIMATED credits, latency, cache hit, conversation id. Delete it to start a new budget period.
# VAKYA_USAGE_FILE=
# credits. OPTIONAL (default 5000). Your credit budget for this period.
# GNANI_CREDIT_BUDGET=5000
# percent. OPTIONAL (default 20). Share of the budget kept for live calls: desk and benchmark work is held back (and
# says so) once it would dip into it. A live call is never refused by the budget.
# GNANI_CREDIT_RESERVE_PCT=20
# rupees per credit. OPTIONAL. Unset means credits are shown without a rupee figure.
# GNANI_RUPEES_PER_CREDIT=
# Rates used to ESTIMATE credits. The defaults are a rival entry's measurements and are NOT verified on your account:
# measure them (docs/GNANI.md) and set the values here, and the summary stops saying "not measured".
# GNANI_RATE_STT_REST_PER_S=0.0097
# GNANI_RATE_STT_STREAM_PER_S=0.0073
# GNANI_RATE_TTS_PER_1K_CHARS=2.9
# GNANI_RATE_CLONE_PER_REQUEST=0
# seconds. OPTIONAL. The wall-clock budget of one request, queue wait and retries included: live call (default 4), desk
# and preview work (60), benchmarks (600). When it is spent a live call is told to play a held line, other work is queued.
# GNANI_LIVE_DEADLINE_S=4
# GNANI_QUEUED_DEADLINE_S=60
# GNANI_BENCH_DEADLINE_S=600
# OPTIONAL. Retries of a 429 or 5xx: default 2 for a live call, 5 otherwise, with exponential backoff and jitter (base
# 0.4 s, cap 4 s, a Retry-After header wins when longer).
# GNANI_MAX_RETRIES=2
# GNANI_BACKOFF_BASE_S=0.4
# GNANI_BACKOFF_MAX_S=4
# OPTIONAL. Circuit breaker: after this many failed requests in a row (default 5) Gnani is paused for GNANI_BREAKER_COOLDOWN_S
# (default 30), then one probe goes through. Out of credits (402) or a rejected key (401/403) pauses it for
# GNANI_ACCOUNT_COOLDOWN_S (default 300). While paused every request is refused at once (live: callback line).
# GNANI_BREAKER_FAILS=5
# GNANI_BREAKER_COOLDOWN_S=30
# GNANI_ACCOUNT_COOLDOWN_S=300
# megabytes. OPTIONAL (default 64, 0 turns it off). In-memory cache of identical TTS and STT requests (same text and voice,
# same audio and parameters): no slot, no credits.
# GNANI_CACHE_MB=64
# on|off. OPTIONAL (default on). Whether a realtime WebSocket session holds the gateway's one slot while it is open.
# GNANI_STREAM_HOLDS_SLOT=on
# live|desk|bench. OPTIONAL (default desk). The lane of a request made outside a turn (scripts: use bench).
# GNANI_DEFAULT_LANE=desk
# on|off. OPTIONAL (default on). Join letter-by-letter acronyms Prisma returns ("O P D" becomes "OPD").
# GNANI_FIX_ACRONYMS=on
# on|off. OPTIONAL (default on). After the first served voice request, render the held lines in the background (about 8
# short Timbre requests) and keep them in VAKYA_HOLD_LINES_DIR (default backend/data/hold_lines).
# GNANI_PREPARE_HOLD_LINES=on
# comma-separated. OPTIONAL (default en,hi; en, hi, mr and hi-en have text). The languages whose held lines are prepared.
# GNANI_HOLD_LINE_LANGUAGES=en,hi

# --- Voice consent, retention and AI labels (compliance pack; not legal advice) ---
# How consent is collected when a voice is cloned. tick (default): one checkbox ("I own this voice or have the speaker's
# permission to clone it for Vakya"); the record stores method "tick", the time, the sample's hash and the name. strict: the
# speaker reads a one-time sentence aloud, checked against a transcript.
# GET /api/consent/mode tells the clone wizard which one is on.
# CONSENT_MODE=tick
# Days a cloned voice is kept, counted from the day it was cloned. Default 365.
# VOICE_RETENTION_DAYS=365
# on (default since 22 Oct 2026): voices past their retention date are deleted at startup and by
# POST /api/voices/retention/enforce, as the consent record promises. off: they are only listed (GET /api/voices/retention).
# VOICE_RETENTION_ENFORCE=on
# Named in the consent purpose ("... for use in Vakya by <name>") and shown as the contact in the notice.
# VAKYA_OPERATOR_NAME=
# VAKYA_PRIVACY_CONTACT=


# Phone calls over Vobiz (docs/PHONE.md; API docs https://www.vobiz.ai/docs). Vobiz is the only phone provider.
# VOBIZ_AUTH_ID=                # Vobiz console: the account's Auth ID (sent as X-Auth-ID)
# VOBIZ_AUTH_TOKEN=             # the Auth Token (sent as X-Auth-Token)
# VOBIZ_CALLER_ID=              # a Vobiz number you own, in international format, e.g. +912269000001
# VOBIZ_BASE_URL=https://api.vobiz.ai/api/v1
# PHONE_PROVIDERS=vobiz         # kept so an old file still loads: it can only name vobiz
# PUBLIC_BASE_URL=https://your-tunnel.ngrok-free.app   # set by ./vakya start from the tunnel; by hand: ngrok http 8021
# The routes Vobiz calls (the call stream, the answer document, the hangup callback and the missed-call hook) are also
# served alone on this phone-only port, in the same process; the tunnel points at it, never at the main API
# (backend/phone_public.py). 0 turns it off.
# PHONE_PUBLIC_PORT=8021
# VAKYA_TUNNEL=auto           # auto (ngrok if installed, else cloudflared) | ngrok | cloudflared | off
# ./vakya reads VAKYA_TUNNEL, PHONE_PUBLIC_PORT and VAKYA_KEEP_AWAKE from the shell first, else from this file.
# Your own tunnel (for example a named Cloudflare tunnel): VAKYA_TUNNEL=off and PUBLIC_BASE_URL=https://phone.example.in
# here; it must point only at the phone-only port above (PHONE_PUBLIC_PORT, default 8021), never at 8020.
# Local mode trusts a request as the local user only from this computer (localhost, no proxy headers). To use the API
# from another device on your network, set a token here and send it as "Authorization: Bearer <token>".
# VAKYA_LOCAL_TOKEN=
# PHONE_ALLOWED_NUMBERS=+919876543210                  # optional: only these can be called
# Missed-call callback ("Call once, it's booked"). In the Vobiz console make an XML Application whose Answer URL is the missed-call
# URL (Desk, Receptionist, Phone number; it ends .../api/phone/missed-call/<token>) and attach a number to it. A call to that
# number is rejected before it is answered (the caller pays nothing) and the receptionist rings the caller back.
# MISSED_CALL_CALLBACK=on       # on | off: with off, missed calls are logged and nobody is called back
# MISSED_CALL_DELAY_S=8         # seconds between the hang-up and the callback
# MISSED_CALL_DEDUPE_S=600      # at most one callback per number in this time (never while a call with that number is live)
# PHONE_EARLY_SILENCE_MS=250    # silence after which a reply starts speculatively (its audio waits for PHONE_END_SILENCE_MS)
# PHONE_SPECULATIVE=on          # on: the whole reply runs during the pause | asr: only speech recognition | off: no head start
# Memory and turn-taking on calls (docs/PHONE.md, "Memory and turn-taking on calls"):
# PHONE_CARRY_UNANSWERED=on     # the words of a reply cancelled before it was stored go with the caller's next utterance
# PHONE_ADAPTIVE_END=on         # wait longer after the agent asked for details (the three waits below)
# PHONE_DETAIL_END_SILENCE_MS=1100    # after it asked for one name, number, date, time, e-mail or address
# PHONE_DETAILS_END_SILENCE_MS=1500   # after it asked for several details at once ("the patient details")
# PHONE_INCOMPLETE_EXTRA_MS=1200      # one extra wait when the answer ends in "and"/"aur"/a comma, or holds 1-9 digits of a number asked for (0: off)
# CALLER_MEMORY=on              # a per-conversation form of what the caller said (name, phone, date, time, ...), shown to the model every turn
# CALLER_MEMORY_LLM=on          # also read it with one small model call per turn, in the background (needs a Embeddings key; never offline)
# VAKYA_CALLER_DETAILS_FILE=  # cloud storage mode only: where the form is kept (default backend/data/caller_details.json, mode 0600)
# CALLER_PROFILES=on            # remember a phone caller across calls (name, language, last booking, follow-ups) and greet them by name next time
# CALLER_PROFILE_RETENTION_DAYS=180   # profiles whose last call is older are deleted at startup; the owner can also forget a caller (DELETE /api/callers/{number})
# CALLER_PROFILE_END_DELAY_S=3  # the profile is written this long after a call ends, so the last words are in it
# PHONE_RETURNING_GREETING_TIMEOUT_S=3   # the longest a known caller waits for their personal greeting; then the agent's usual greeting plays
# VAKYA_CALLER_PROFILES_FILE= # where profiles are kept (default backend/data/caller_profiles.json, mode 0600; hosted mode uses the caller_profiles table, migration 021)
# Privacy: a profile holds the caller's number (in full), name, language and last booking, kept only "to serve them on their next call"; it says so in its consent_note.
# PHONE_PREWARM=on              # off: no background greeting renders and warm-ups (a call still renders its own greeting)
# PHONE_MAX_CALLS=2             # live calls at once; a further call is refused (close 4429) so Vobiz moves on to the application's Fallback URL (a person)
# Heartbeat: POST a small JSON ping here every VAKYA_HEARTBEAT_S seconds (a healthchecks.io / Uptime Kuma "ping" URL), so the
# checker alerts you within two minutes when the laptop sleeps, loses Wi-Fi or the backend stops. GET /api/health shows the
# last ping and any gap the loop noticed. Unset: nothing is sent; offline mode refuses it.
# VAKYA_HEARTBEAT_URL=
# VAKYA_HEARTBEAT_S=60
# ./vakya start keeps the Mac awake while the API runs (caffeinate -is). off: leave power management alone.
# VAKYA_KEEP_AWAKE=on
# Committing tools (book_appointment) first answer NOT DONE with the resolved day, date and time for the agent
# to read back ("Shall I book it?") and run on the next call once the caller said yes. off: one-step writes, as before 22 Oct 2026.
# TOOLS_READBACK=on
# PHONE_PREWARM_MAX=8           # how many phone agents get their greeting rendered (or checked) at startup
# Turn-taking on a call has no speech model. The caller's turn ends after PHONE_END_SILENCE_MS of quiet (longer when the agent
# asked for details: the three waits above), and an energy gate with hysteresis on the 8 kHz stream decides what is speech:
# PHONE_END_SILENCE_MS=500      # ms of silence that end a turn when nothing special was asked
# PHONE_VAD_ENTER_RMS=0.012     # a frame is speech above max(this, noise floor x PHONE_VAD_NOISE_X)
# PHONE_VAD_NOISE_X=3           # how far above the learnt line noise speech must be
# PHONE_VAD_LEAVE_RATIO=0.55    # speech lasts until a frame falls under this fraction of the enter level
# PHONE_BARGE_RMS=0.02          # the caller cuts in only when their speech averages at least this loud (0 = any speech)

# PHONE_PREWARM_DELAY_S=5       # how long after startup that render starts, so it does not slow the startup down
# PHONE_WARM_TTL_S=60           # a warm-up of the same agent within this many seconds is skipped
# PHONE_GREETING_DIR=           # where rendered greetings are cached (default backend/data/phone_greetings, git-ignored)

# Google Calendar for bookings. To connect a calendar: create a Google Cloud service account, enable the Calendar API, share
# the calendar with the service account's e-mail ("Make changes to events"), and save its JSON key as
# backend/data/google_calendar.json (git-ignored).
# GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
# GOOGLE_SERVICE_ACCOUNT_FILE=backend/data/google_calendar.json
# VAKYA_TIMEZONE=Asia/Kolkata

# Reply latency (a live spoken turn)
# TURN_FIRST_CLAUSE=on          # on (default): the first piece of a reply goes to the voice at its first comma, semicolon,
#                               # colon or dash once 4 words are in, else at a conjunction or the 8th word, instead of at the
#                               # end of the sentence. off: the older rule (a cut only after 8 words, at a comma/conjunction).
# FILLER_AUDIO=on               # the short "One moment." clip played when the answer is slow; off turns it off
# FILLER_AFTER_MS=900           # how long a typed/web turn may be silent before the filler plays
# PHONE_FILLER_AFTER_MS=500     # the same for phone calls (silence on a phone sounds like a dropped call). The filler is
#                               # never played once the model has started answering, nor while the AI disclosure plays.
# WARM_ON_START=auto            # auto (default) | on | off. Gets a live reply ready in the background when the backend starts:
#                               # the Gnani key check and the held lines ("one moment", "I will call you back", rendered once
#                               # by Timbre and kept on disk), the language model's connection, one embedding. auto = on when the
#                               # three VOBIZ_* settings are set or any agent exists.
# WARM_CLIPS=off                # on: also render the filler and disclosure clips ahead (a few Timbre requests at every start)


# Document ingestion: structure-aware passages and the question index (services/chunking.py, services/question_index.py)
# STRUCTURED_CHUNKING=on        # on (default): passages follow headings, FAQ pairs and table rows, each with a "Title > Section"
#                               # header (stored apart; header + content is what is embedded). PDFs are read in layout mode so
#                               # tables keep their columns. off: the older line-based passages without headers.
# QUESTION_INDEX=on             # on (default): after a document is stored, a background job asks the hosted model for 2-3 questions
#                               # per passage in English, Hindi (Devanagari) and Hinglish and stores them as search rows that
#                               # point back to their passage. Never blocks the upload; skipped when no hosted model is set.
# QUESTION_INDEX_BATCH=4        # passages per model call
# QUESTION_INDEX_MIN_INTERVAL_S=2   # smallest gap between two model calls
# QUESTION_INDEX_RETRIES=4      # tries per call when the model answers 429 or fails

# (services/grounding.py, services/fact_sheet.py, services/llm.py)
# GROUNDING_PROMPT=v2           # v2 (default): copy numbers/times/fees/names exactly and write them in digits in every
#                               # language, never confirm a day/time/price/person/service the caller assumes unless the
#                               # passages say it (say what they do say), no yes/no about things they never mention,
#                               # refuse and offer a call back when the passages lack the answer, answer first then at most
#                               # one detail, 3 short examples (English, a Hindi correction of a wrong day, a Hinglish
#                               # refusal). v1: the earlier prompt, for A/B comparison.
# RETRIEVAL_TOP_K=4             # passages retrieved per turn (default 4: the doc QA evaluation found every top-3 miss at
#                               # rank 4; one passage is about 170 prompt tokens). Read at start-up.
# GROUNDING_TOP_K=              # passages shown to the model with the v2 prompt (best first, question last); default: the
#                               # same as RETRIEVAL_TOP_K
# ANSWER_GUARD=on               # every number, time, fee, phone number and date in a reply must appear in the passages, the
#                               # key facts, the agent's instructions/greeting, the caller's words or a tool's result; a
#                               # sentence that names one that does not is replaced by the callback line before it is spoken
#                               # and the reply stops there (turn timings: guard="number"). Under 1 ms per sentence.
# CONFIDENCE_GATE=on            # retrieval rated its passages "none"/"low": no model call, the callback line is the reply
#                               # (timings: guard="low_confidence"). Not for small talk, tool agents, a reply to the agent's
#                               # own question, or when the rating is missing.
# FACT_SHEET=on                 # per agent, the hosted model lists the hard facts of its documents once per document set
#                               # (timings, fees, phones, addresses, doctor days; every value checked verbatim against the
#                               # text) and the ones that match a question go into the prompt as "Key facts". Built in the
#                               # background, never waited for; skipped without a hosted model.
# FACT_SHEET_DIR=               # where sheets are cached (default backend/data/fact_sheets, git-ignored)

# Query understanding on a live turn (services/query_understanding.py): entity snapping and follow-up condensation.
# QUERY_ENTITY_SNAP=on          # snap near-miss names/terms in the transcript to the agent's lexicon (search query only)
# QUERY_CONDENSE=on             # on | rules | off: rewrite short follow-ups ("aur Monday ko?") into a standalone search
#                               # query; rules first, a small model call only when rules cannot (rules = never the model)
# QUERY_CONDENSE_TIMEOUT_MS=400 # the condensation call's limit; on timeout the raw transcript is searched

# Retrieval (services/retrieval.py; bench: backend/bench/retrieval_modes_bench.py)
# RETRIEVAL_FUSION=weighted     # weighted (default) | rrf: how the embedding and BM25 rankings are fused
# RETRIEVAL_WEIGHTS=dense:0.8,bm25:0.2
# RETRIEVAL_NORM=tmm            # tmm (default): score / best score; minmax: (score - min) / (max - min) over the candidates
# RETRIEVAL_CANDIDATES=20       # candidates = union of the embedding top-N and the BM25 top-N

# Offline mode: 1 refuses Gnani, Embeddings, remote language-model servers, Supabase, Google Calendar and Vobiz phone calls, so
# nothing leaves this computer (the desk, the schedules and keyword search keep working).
# GET /api/privacy/attestation then returns a signed statement of this configuration.
# VAKYA_OFFLINE=0

# Receipt signing-key rotation: `backend/scripts/rotate_receipt_key.py --yes` (API stopped) retires the current Ed25519 key into
# data/receipt_ed25519.retired and starts a new one; old receipts and withdrawal-log rows keep verifying by their key_id, and
# /.well-known/vakya-receipt-key lists every key. When the key lives in VAKYA_RECEIPT_SIGNING_KEY, rotate it by hand and
# list the old public keys (base64, comma-separated) here:
# VAKYA_RECEIPT_RETIRED_KEYS=
# C2PA manifest on every generated WAV (services/c2pa_manifest.py): a signed, standard provenance record beside the signed receipt,
# readable by c2patool and Content Credentials, with the receipt id and key id inside. Needs `backend/.venv/bin/pip install
# c2pa-python` (Apache-2.0 OR MIT). Without a real certificate a self-signed test chain is made in data/c2pa/ (readers show it as
# an untrusted signer: integrity, not identity). The audio samples are untouched; /verify shows the manifest.
# C2PA_MANIFEST=off
# C2PA_CERT_FILE=                # PEM: signing certificate then its chain
# C2PA_KEY_FILE=                 # PEM: PKCS#8 private key
# VAKYA_PUBLIC_URL=            # if set, the manifest carries verify_url and keys_url under this address

# Voice vault: cloned voices are sealed on disk (AES-256-GCM); withdrawing consent destroys the key. See docs/VOICE_VAULT.md.
# VOICE_VAULT=on                # off: keep voice files plain
# VAKYA_VAULT_KEY=            # base64 of 32 bytes; default: macOS Keychain, else ~/.vakya/voice_kek. Back it up with your voices.
# VOICE_VAULT_KEYCHAIN=on       # off: skip the macOS Keychain
