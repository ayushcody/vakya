        },
        {
          "id": "details",
          "max_uses": 3,
          "when": {
            "agent_any": [
              "@asks_details"
            ],
            "agent_none": [
              "@asks_confirm"
            ]
          },
          "say": {
            "text": "माझं नाव {name}. माझा फोन नंबर {phone}."
          }
        },
        {
          "id": "yes",
          "max_uses": 3,
          "when": {
            "agent_any": [
              "@asks_confirm",
              "?"
            ]
          },
          "say": {
            "text": "हो, चालेल. बुक करा."
          }
        }
      ],
      "expect": {
        "bookings": [
          {
            "schedule": "Doctor consultations",
            "date": "target",
            "time": "11:00",
