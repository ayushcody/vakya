    "asks_details": [
      "name",
      "phone",
      "number",
      "contact",
      "mobile",
      "नाम",
      "नंबर",
      "नाव",
      "फोन",
      "मोबाइल",
      "मोबाईल"
    ],
    "asks_confirm": [
      "shall i book",
      "shall i cancel",
      "should i",
      "do you want me to",
      "book it",
      "बुक करूँ",
      "बुक करूं",
      "बुक करू",
      "book karoon",
      "book karun",
      "book karu",
      "बुक कर दूँ",
      "बुक कर दूं",
      "radd karoon",
      "रद्द करूँ",
      "रद्द करूं",
      "रद्द करू",
      "cancel booking",
      "ठीक है?",
      "सही है?",
      "सही आहे",
      "चालेल का"
    ],
    "clarify": [
      "could you repeat",
      "say that again",
      "did not catch",
      "didn't catch",
      "please repeat",
      "once more please",
      "सुन नहीं",
      "समझ नहीं",
      "समझ नही",
      "फिर से बोल",
      "फिर से कह",
      "ऐकू आले नाही",
      "समजले नाही",
      "पुन्हा बोला",
      "पुन्हा सांगा",
      "phir se bol",
      "phir se kah"
    ],
    "refuses": [
      "आधार",
      "aadhaar",
      "aadhar",
      "id number",
      "नहीं ले",
      "नहीं ज़रूरत",
      "ज़रूरत नहीं",
      "जरूरत नहीं",
      "नहीं चाहिए",
      "नहीं कर सक",
