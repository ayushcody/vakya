# Vakya environment. Copy to .env (docker compose) and/or frontend/.env.local
# (the backend loads ../frontend/.env.local at startup; real env vars win).
# For a local run without Docker the settings live in backend/.env (see backend/.env.example).

# ---- Shared (frontend + backend) ----
# string, URL. OPTIONAL. Supabase project URL, for hosted multi-user mode. Leave all Supabase settings empty for local mode.
NEXT_PUBLIC_SUPABASE_URL=
# string. OPTIONAL (frontend). Supabase anon/public key (browser-safe).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# string, URL. OPTIONAL (default http://localhost:8020). Backend base URL seen by the browser.
NEXT_PUBLIC_API_URL=http://localhost:8020

# ---- Backend ----
# string. OPTIONAL (backend). Supabase service-role key. SECRET, server only.
SUPABASE_SERVICE_ROLE_KEY=
# string. OPTIONAL. Needed to verify sign-in tokens in hosted mode. SECRET.
SUPABASE_JWT_SECRET=
# string. OPTIONAL. Single-account demo: a long random string (openssl rand -hex 24), also set as NEXT_PUBLIC_VAKYA_LOCAL_TOKEN.
# VAKYA_LOCAL_TOKEN=
# string, comma separated. The origin(s) of the web app when it is served from another address. No trailing slash.
# CORS_ORIGINS=https://vakya.example.in

# ---- Gnani AI: speech (see docs/GNANI.md) ----
# string. REQUIRED for any call. Gnani AI (Vachana) API key, sent as the X-API-Key-ID header. SECRET. It turns on Prisma
# (hearing), Timbre (speaking) and voice cloning. There is no second speech provider and no local speech model.
GNANI_API_KEY=
# string, URL. OPTIONAL (default https://api.vachana.ai).
GNANI_BASE_URL=https://api.vachana.ai
# prisma-v3.0|prisma-v2.5. OPTIONAL (default prisma-v3.0; only v3.0 takes several language codes as a hint).
GNANI_STT_MODEL=prisma-v3.0
# verbatim|transcribe|codemix|transliterate. OPTIONAL (default codemix: English in Latin script, numbers in words).
GNANI_STT_FORMAT=codemix
# string. OPTIONAL (default timbre-v2.5). Voice cloning always uses vachana-vc-v1.
GNANI_TTS_MODEL=timbre-v2.5
# string. OPTIONAL. Timbre voices as Name:language pairs; the first match for a language speaks it.
# Default: Nalini:hi,Kaveri:en,Poorvi:hi-en
GNANI_VOICES=Nalini:hi,Kaveri:en,Poorvi:hi-en
# string. OPTIONAL. Comma-separated words always sent to Prisma as keyterms (up to 200, with the agent's own names
# and terms): product names, clinic or university names, doctors.
GNANI_KEYTERMS=
# integer, credits. OPTIONAL (default 5000). Your credit budget; a share is kept in reserve for live calls.
# GNANI_CREDIT_BUDGET=5000

# ---- Embeddings (Google): replies and document search ----
# string. REQUIRED for replies. Embeddings API key. SECRET. Embeddings Flash writes the replies and chooses the tools; Embeddings
# embeddings search the business's documents, with keyword search as the backup.
EMBEDDINGS_API_KEY=

# ---- Vobiz: telephony (see docs/PHONE.md) ----
# string. OPTIONAL. Needed for real phone calls and the missed-call callback. The browser web call works without them.
# VOBIZ_AUTH_ID=
# VOBIZ_AUTH_TOKEN=                     SECRET
# VOBIZ_CALLER_ID=+912269000001         a Vobiz number you own, in international format
# string, URL. The public HTTPS address of the phone-only port (8021), when you do not use ./vakya's tunnel.
# PUBLIC_BASE_URL=https://phone.example.in

# ---- docker-compose ----
# string. OPTIONAL. Credentials for the bundled postgres service.
POSTGRES_USER=vakya
POSTGRES_PASSWORD=vakya_dev
POSTGRES_DB=vakya
# string. OPTIONAL. Base image for the backend container.
BACKEND_BASE_IMAGE=python:3.11-slim

# NODE_ENV (development|production) is set by Next.js itself; do not set manually.
