{
  "ci": {
    "collect": {
      "startServerCommand": "npx next start -p 3204",
      "startServerReadyPattern": "Ready",
      "url": ["http://localhost:3204/", "http://localhost:3204/how-it-works"],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.8, "aggregationMethod": "median-run" }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1, "aggregationMethod": "median-run" }]
          }
        },
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:performance": ["warn", { "minScore": 0.9, "aggregationMethod": "median-run" }],
            "largest-contentful-paint": ["warn", { "maxNumericValue": 2500, "aggregationMethod": "median-run" }],
            "total-blocking-time": ["warn", { "maxNumericValue": 300, "aggregationMethod": "median-run" }],
            "resource-summary:script:size": ["warn", { "maxNumericValue": 460000 }],
            "categories:accessibility": ["warn", { "minScore": 0.9, "aggregationMethod": "median-run" }]
          }
        }
      ]
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
