NEXT_PUBLIC_API_URL=http://localhost:8020
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Demo only: a shared single-account token, sent as the Bearer token when nobody is signed in. It must equal the backend's
# VAKYA_LOCAL_TOKEN. NEXT_PUBLIC_ values are bundled into the page, so anyone who opens the site can read it and act as
# that one account. Never use it for real customer data.
NEXT_PUBLIC_VAKYA_LOCAL_TOKEN=
